<Window x:Class="AmerikaKamaraFirin.View.ReceteDuzenle"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AmerikaKamaraFirin.View"
        Title="Reçete Düzenle" Width="840" Height="750" WindowStyle="None" AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown" MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <local:IndexToOneBasedConverter x:Key="IndexToOneBased"/>
        <Style x:Key="ShadowCard" TargetType="Border">
            <Setter Property="Background" Value="#1e1e2e"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#3a3a4a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Border Background="#7F000000" BorderBrush="Blue" BorderThickness="2">
        <Viewbox Stretch="Fill">
            <Grid Width="640" Height="550" Background="Black">
                <Border CornerRadius="0" Opacity="0.5">
                    <Border.Background>
                        <ImageBrush ImageSource="/View/images/background2.png" Stretch="Fill" />
                    </Border.Background>
                </Border>

                <!-- Üst Başlık Alanı -->
                <Border Height="30" VerticalAlignment="Top" Background="#FF000319">
                    <Grid>
                        <TextBlock Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" Foreground="White" Text="Reçete Düzenle"/>
                        <Button Width="38" Height="25" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#FFCE2626" Click="Close_Click" Content="X" Foreground="White"/>
                    </Grid>
                </Border>

                <!-- İçerik Alanı -->
                <StackPanel Margin="20,40,20,20">
                    <TextBlock Text="Reçete Adı:" Foreground="White"/>
                    <TextBox x:Name="txtReceteAdi" Margin="0,5" Background="#333" Foreground="White" BorderBrush="#555"/>

                    <TextBlock Text="Adımlar:" Margin="0,10,0,5" Foreground="White"/>
                    <ListView x:Name="lstAdimlar" Height="260" Margin="0,0,0,10" AlternationCount="1000" Background="Transparent" BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ShadowCard}" Width="550">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                            <TextBlock Text="Adım " Foreground="White"/>
                                            <TextBlock Text="{Binding AdimNo}" Foreground="White"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,30,0,0">
                                            <Label Content="Hedef Sıcaklık" Foreground="White" Margin="10,0,10,0"/>
                                            <TextBox Width="80" Text="{Binding HedefSicaklik}" Margin="0,0,10,0" Background="#444" Foreground="White" BorderBrush="#666"/>
                                            <Label Content="Süre" Foreground="White" Margin="50,0,10,0"/>
                                            <TextBox Width="80" Text="{Binding SureDakika}" Background="#444" Foreground="White" BorderBrush="#666"/>
                                        </StackPanel>
                                        <Button Content="   X   " Background="Red" Foreground="White" FontWeight="ExtraBold" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0" Click="SilAdim_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Yeni adım ekleme alanı -->
                    <Border Style="{StaticResource ShadowCard}" Margin="10,0,0,0" Width="550">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <TextBlock Text="Adım " Foreground="White"/>
                                <TextBlock Text="" Foreground="White"/>
                            </StackPanel>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,30,0,0">
                                <Label Content="Hedef Sıcaklık" Foreground="White" Margin="10,0,10,0"/>
                                <TextBox x:Name="txtYeniSicaklik" Width="80" Margin="0,0,10,0" Background="#444" Foreground="White" BorderBrush="#666"/>
                                <Label Content="Süre" Foreground="White" Margin="50,0,10,0"/>
                                <TextBox x:Name="txtYeniSure" Width="80" Background="#444" Foreground="White" BorderBrush="#666"/>
                            </StackPanel>
                            <Button Content=" ADD " Background="Green" Foreground="White" FontWeight="ExtraBold" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0" Click="EkleAdim_Click"/>
                        </Grid>
                    </Border>

                    <!-- Kaydet butonu -->
                    <Button Content="Kaydet" Margin="0,10,0,0" HorizontalAlignment="Right" Width="100" Height="35" Background="#4CAF50" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="Button_Click"/>
                </StackPanel>
            </Grid>
        </Viewbox>
    </Border>
</Window>
