<Window
    x:Class="AmerikaKamaraFirin.View.Message"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AmerikaKamaraFirin.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:AmerikaKamaraFirin"
    Title="Bilgilendirme"
    Width="450"
    Height="180"
    Background="Transparent"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">
    <Border
        Background="{DynamicResource {x:Static SystemColors.DesktopBrushKey}}"
        BorderBrush="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        BorderThickness="1,1,1,1"
        CornerRadius="6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="0*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="MessageText"
                Margin="0,57,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                FontSize="24"
                Foreground="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                Text="{x:Static resx:Resources.hata_icerigi_gunluge_kaydedildi}"
                TextWrapping="Wrap" />
            <Button
                Width="128"
                Height="35"
                Margin="0,117,0,0"
                Padding="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="{DynamicResource {x:Static SystemColors.InactiveCaptionTextBrushKey}}"
                Click="CloseButton_Click"
                Content="{x:Static resx:Resources.tamam}"
                FontSize="18"
                FontWeight="Bold"
                Foreground="{DynamicResource {x:Static SystemColors.MenuBrushKey}}" />
        </Grid>
    </Border>
</Window>

