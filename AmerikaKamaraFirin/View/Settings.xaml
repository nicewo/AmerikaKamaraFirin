<Page
    x:Class="AmerikaKamaraFirin.View.Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AmerikaKamaraFirin.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:AmerikaKamaraFirin"
    Title="Settings"
    d:DesignHeight="604"
    d:DesignWidth="1024"
    Foreground="White"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid>
        <Label
            x:Name="lbl_frekans"
            Margin="80,74,814,485"
            Content="Pomp Speed"
            FontSize="20"
            FontWeight="Bold"
            Foreground="White" />
        <TextBox
            x:Name="txb_frekans"
            Margin="80,124,814,407"
            FontSize="50"
            FontWeight="Bold"
            PreviewMouseDown="PreviewMouseDown"
            Text="50"
            TextWrapping="Wrap" />
        <Label
            x:Name="lbl_minTemp"
            Margin="360,79,398,480"
            Content="Min. Door Opening Temp."
            FontSize="20"
            FontWeight="Bold"
            Foreground="White" />
        <TextBox
            x:Name="txb_minTemp"
            Margin="428,124,466,407"
            FontSize="50"
            FontWeight="Bold"
            PreviewMouseDown="PreviewMouseDown"
            Text="50"
            TextWrapping="Wrap" />
        <Label
            x:Name="lbl_tempFark"
            Margin="694,79,26,480"
            Content="Thermocouple Error Tolerance"
            FontSize="20"
            FontWeight="Bold"
            Foreground="White" />
        <TextBox
            x:Name="txb_tempFark"
            Margin="762,124,132,407"
            FontSize="50"
            FontWeight="Bold"
            PreviewMouseDown="PreviewMouseDown"
            Text="50"
            TextWrapping="Wrap" />
        <Button
            x:Name="button"
            Margin="958,553,0,0"
            Background="#00000000"
            Click="button_Click"
            Content="."
            Foreground="White" />
    </Grid>
</Page>
