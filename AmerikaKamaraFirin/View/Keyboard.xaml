<Window
    x:Class="AmerikaKamaraFirin.View.Keyboard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AmerikaKamaraFirin.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:AmerikaKamaraFirin"
    Title="Keyboard"
    Width="840"
    Height="450"
    Background="#000000"
    Loaded="Window_Loaded"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Border
        Background="#7F000000"
        BorderBrush="Blue"
        BorderThickness="2">
        <Viewbox Stretch="Fill">
            <Grid
                Width="640"
                Height="550"
                Background="Black">
                <Border CornerRadius="0" Opacity="0.5">
                    <Border.Background>
                        <ImageBrush ImageSource="/View/images/background2.png" Stretch="Fill" />
                    </Border.Background>
                </Border>

                <!--  Üst Başlık Alanı  -->
                <Border
                    Height="35"
                    VerticalAlignment="Top"
                    Background="#FF000319">
                    <Grid>
                        <Button
                            Width="38"
                            Height="35"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="#FFCE2626"
                            Click="Close_Click"
                            Content="X"
                            Foreground="White"
                            PreviewTouchDown="Close_PreviewTouchDown" />
                    </Grid>
                </Border>

                <!--  İçerik Alanı  -->
                <StackPanel Margin="0">
                    <TextBox
                        x:Name="KeyText"
                        Width="500"
                        Height="50"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Arial"
                        FontSize="25"
                        FontWeight="Bold"
                        Foreground="#FF100202"
                        Text="" />


                    <Grid Height="462" Margin="0,10,0,0">
                        <UniformGrid
                            Width="620"
                            Margin="0,37,0,0"
                            HorizontalAlignment="Center"
                            Columns="10"
                            Rows="4">

                            <!--  0. Satır  -->
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content="0"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content="1"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content="2"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content="3"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content="4"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content="5"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content="6"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content="7"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content="8"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content="9"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />


                            <!--  1. Satır  -->
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content="Q"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content="W"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content="E"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content="R"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content="T"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content="Y"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content="U"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content="I"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content="O"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content="P"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />

                            <!--  2. Satır  -->
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content="A"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content="S"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content="D"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content="F"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content="G"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content="H"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content="J"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content="K"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content="L"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />
                            <Button
                                Background="#FF162355"
                                Click="Backspace_Click"
                                Content="←"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="#FFF90000"
                                PreviewTouchDown="Backspace_PreviewTouchDown" />

                            <!--  3. Satır  -->
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content="Z"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content="X"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content="C"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content="V"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content="B"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content="N"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content="M"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content="."
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />
                            <Button
                                Background="#FF162355"
                                Click="Key_Click"
                                Content=" "
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="White"
                                PreviewTouchDown="Key_PreviewTouchDown" />
                            <Button
                                Background="#FF162355"
                                Click="Enter_Click"
                                Content="OK"
                                FontSize="36"
                                FontWeight="Bold"
                                Foreground="#FF32EA00"
                                PreviewTouchDown="Enter_PreviewTouchDown" />
                        </UniformGrid>
                    </Grid>



                </StackPanel>
            </Grid>
        </Viewbox>
    </Border>

</Window>
