<Window
    x:Class="AmerikaKamaraFirin.View.Keyboard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AmerikaKamaraFirin.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:AmerikaKamaraFirin"
    Title="Keyboard"
    Width="840"
    Height="450"
    AllowsTransparency="True"
    Background="Transparent"
    Deactivated="Window_Deactivated"
    KeyDown="Window_KeyDown"
    MouseLeftButtonDown="Window_MouseLeftButtonDown"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <local:IndexToOneBasedConverter x:Key="IndexToOneBased" />
        <Style x:Key="ShadowCard" TargetType="Border">
            <Setter Property="Background" Value="#1e1e2e" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderBrush" Value="#3a3a4a" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="5" />
        </Style>

        <Style x:Key="KeyboardButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="5" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#333" />
            <Setter Property="BorderBrush" Value="#666" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#555" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#777" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border
        Background="#7F000000"
        BorderBrush="Blue"
        BorderThickness="2">
        <Viewbox Stretch="Fill">
            <Grid
                Width="640"
                Height="550"
                Background="Black">
                <Border CornerRadius="0" Opacity="0.5">
                    <Border.Background>
                        <ImageBrush ImageSource="/View/images/background2.png" Stretch="Fill" />
                    </Border.Background>
                </Border>

                <!--  Üst Başlık Alanı  -->
                <Border
                    Height="35"
                    VerticalAlignment="Top"
                    Background="#FF000319">
                    <Grid>
                        <Button
                            Width="38"
                            Height="35"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="#FFCE2626"
                            Click="Close_Click"
                            Content="X"
                            Foreground="White" />
                    </Grid>
                </Border>

                <!--  İçerik Alanı  -->
                <StackPanel Margin="0">
                    <TextBox
                        x:Name="KeyText"
                        Width="500"
                        Height="50"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Arial"
                        FontSize="25"
                        FontWeight="Bold"
                        Foreground="#FF100202"
                        Text="" />


                    <Grid Height="462" Margin="0,10,0,0">
                        <UniformGrid
                            Width="620"
                            Margin="0,37,0,0"
                            HorizontalAlignment="Center"
                            Columns="10"
                            Rows="4">

                            <!--  0. Satır  -->
                            <Button
                                Click="Key_Click"
                                Content="0"
                                Style="{StaticResource KeyboardButtonStyle}" />
                            <Button
                                Click="Key_Click"
                                Content="1"
                                Style="{StaticResource KeyboardButtonStyle}" />
                            <Button
                                Click="Key_Click"
                                Content="2"
                                Style="{StaticResource KeyboardButtonStyle}" />
                            <Button
                                Click="Key_Click"
                                Content="3"
                                Style="{StaticResource KeyboardButtonStyle}" />
                            <Button
                                Click="Key_Click"
                                Content="4"
                                Style="{StaticResource KeyboardButtonStyle}" />
                            <Button
                                Click="Key_Click"
                                Content="5"
                                Style="{StaticResource KeyboardButtonStyle}" />
                            <Button
                                Click="Key_Click"
                                Content="6"
                                Style="{StaticResource KeyboardButtonStyle}" />
                            <Button
                                Click="Key_Click"
                                Content="7"
                                Style="{StaticResource KeyboardButtonStyle}" />
                            <Button
                                Click="Key_Click"
                                Content="8"
                                Style="{StaticResource KeyboardButtonStyle}" />
                            <Button
                                Click="Key_Click"
                                Content="9"
                                Style="{StaticResource KeyboardButtonStyle}" />


                            <!--  1. Satır  -->
                            <Button
                                Click="Key_Click"
                                Content="Q"
                                Style="{StaticResource KeyboardButtonStyle}" />
                            <Button
                                Click="Key_Click"
                                Content="W"
                                Style="{StaticResource KeyboardButtonStyle}" />
                            <Button
                                Click="Key_Click"
                                Content="E"
                                Style="{StaticResource KeyboardButtonStyle}" />
                            <Button
                                Click="Key_Click"
                                Content="R"
                                Style="{StaticResource KeyboardButtonStyle}" />
                            <Button
                                Click="Key_Click"
                                Content="T"
                                Style="{StaticResource KeyboardButtonStyle}" />
                            <Button
                                Click="Key_Click"
                                Content="Y"
                                Style="{StaticResource KeyboardButtonStyle}" />
                            <Button
                                Click="Key_Click"
                                Content="U"
                                Style="{StaticResource KeyboardButtonStyle}" />
                            <Button
                                Click="Key_Click"
                                Content="I"
                                Style="{StaticResource KeyboardButtonStyle}" />
                            <Button
                                Click="Key_Click"
                                Content="O"
                                Style="{StaticResource KeyboardButtonStyle}" />
                            <Button
                                Click="Key_Click"
                                Content="P"
                                Style="{StaticResource KeyboardButtonStyle}" />

                            <!--  2. Satır  -->
                            <Button
                                Click="Key_Click"
                                Content="A"
                                Style="{StaticResource KeyboardButtonStyle}" />
                            <Button
                                Click="Key_Click"
                                Content="S"
                                Style="{StaticResource KeyboardButtonStyle}" />
                            <Button
                                Click="Key_Click"
                                Content="D"
                                Style="{StaticResource KeyboardButtonStyle}" />
                            <Button
                                Click="Key_Click"
                                Content="F"
                                Style="{StaticResource KeyboardButtonStyle}" />
                            <Button
                                Click="Key_Click"
                                Content="G"
                                Style="{StaticResource KeyboardButtonStyle}" />
                            <Button
                                Click="Key_Click"
                                Content="H"
                                Style="{StaticResource KeyboardButtonStyle}" />
                            <Button
                                Click="Key_Click"
                                Content="J"
                                Style="{StaticResource KeyboardButtonStyle}" />
                            <Button
                                Click="Key_Click"
                                Content="K"
                                Style="{StaticResource KeyboardButtonStyle}" />
                            <Button
                                Click="Key_Click"
                                Content="L"
                                Style="{StaticResource KeyboardButtonStyle}" />
                            <Button
                                Click="Backspace_Click"
                                Content="←"
                                Foreground="#FFF90000"
                                Style="{StaticResource KeyboardButtonStyle}" />

                            <!--  3. Satır  -->
                            <Button
                                Click="Key_Click"
                                Content="Z"
                                Style="{StaticResource KeyboardButtonStyle}" />
                            <Button
                                Click="Key_Click"
                                Content="X"
                                Style="{StaticResource KeyboardButtonStyle}" />
                            <Button
                                Click="Key_Click"
                                Content="C"
                                Style="{StaticResource KeyboardButtonStyle}" />
                            <Button
                                Click="Key_Click"
                                Content="V"
                                Style="{StaticResource KeyboardButtonStyle}" />
                            <Button
                                Click="Key_Click"
                                Content="B"
                                Style="{StaticResource KeyboardButtonStyle}" />
                            <Button
                                Click="Key_Click"
                                Content="N"
                                Style="{StaticResource KeyboardButtonStyle}" />
                            <Button
                                Click="Key_Click"
                                Content="M"
                                Style="{StaticResource KeyboardButtonStyle}" />
                            <Button
                                Click="Key_Click"
                                Content="."
                                Style="{StaticResource KeyboardButtonStyle}" />
                            <Button
                                Click="Key_Click"
                                Content=" "
                                Style="{StaticResource KeyboardButtonStyle}" />
                            <Button
                                Click="Enter_Click"
                                Content="OK"
                                Foreground="#FF32EA00"
                                Style="{StaticResource KeyboardButtonStyle}" />
                        </UniformGrid>
                    </Grid>



                </StackPanel>
            </Grid>
        </Viewbox>
    </Border>

</Window>
