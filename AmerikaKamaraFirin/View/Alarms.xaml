<Page
    x:Class="AmerikaKamaraFirin.View.Alarms"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AmerikaKamaraFirin.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:AmerikaKamaraFirin"
    Title="Alarms"
    d:DesignHeight="604"
    d:DesignWidth="1024"
    mc:Ignorable="d">

    <Grid Margin="20">
        <TabControl
            x:Name="alarmTabs"
            SelectedIndex="0"
            SelectionChanged="alarmTabs_SelectionChanged">
            <TabItem Header="{x:Static resx:Resources.AktifAlarm}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <ListBox
                            x:Name="lstLog0"
                            Margin="10"
                            Background="#1e1e2e"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            FontFamily="Consolas"
                            FontSize="14"
                            Foreground="White" />
                    </ScrollViewer>

                    <Button
                        x:Name="ResetAlarm"
                        Grid.Row="1"
                        Width="220"
                        Height="55"
                        Margin="10"
                        HorizontalAlignment="Right"
                        Background="DarkRed"
                        Click="ResetAlarm_Click"
                        Content="{x:Static resx:Resources.Temizle}"
                        FontWeight="Bold"
                        Foreground="White" />
                </Grid>
            </TabItem>

            <TabItem x:Name="GecmisAlarmTab" Header="{x:Static resx:Resources.GecmisAlarm}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ListBox
                        x:Name="lstLog"
                        Margin="10"
                        Background="#1e1e2e"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        FontFamily="Consolas"
                        FontSize="14"
                        Foreground="White" />
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
