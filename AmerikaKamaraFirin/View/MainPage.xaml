<Page
    x:Class="AmerikaKamaraFirin.View.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UControl="clr-namespace:AmerikaKamaraFirin.View.UControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AmerikaKamaraFirin.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:AmerikaKamaraFirin"
    Title="MainPage"
    d:DesignHeight="604"
    d:DesignWidth="1024"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="320" />
            <RowDefinition Height="20" />
            <RowDefinition />
        </Grid.RowDefinitions>


        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <UControl:UpDownTextbox
                x:Name="solUpDown"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Margin="176,10,396,0"
                VerticalAlignment="Top"
                ArrowLeftClicked="solUpDown_ArrowLeftClicked"
                ArrowRightClicked="solUpDown_ArrowRightClicked">
                <UControl:UpDownTextbox.RenderTransform>
                    <ScaleTransform ScaleX="-1" />
                </UControl:UpDownTextbox.RenderTransform>
            </UControl:UpDownTextbox>
            <UControl:LeftRightTextbox
                x:Name="solLeftRight"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Margin="176,0,396,10"
                VerticalAlignment="Bottom"
                ArrowLeftClicked="solLeftRight_ArrowLeftClicked"
                ArrowRightClicked="solLeftRight_ArrowRightClicked">
                <UControl:LeftRightTextbox.RenderTransform>
                    <ScaleTransform ScaleX="-1" />
                </UControl:LeftRightTextbox.RenderTransform>
            </UControl:LeftRightTextbox>




            <UControl:UpDownTextbox
                x:Name="sagUpDown"
                Grid.Column="4"
                Margin="10"
                VerticalAlignment="Top"
                ArrowLeftClicked="sagUpDown_ArrowLeftClicked"
                ArrowRightClicked="sagUpDown_ArrowRightClicked" />
            <UControl:LeftRightTextbox
                x:Name="sagLeftRight"
                Grid.Column="4"
                Margin="10"
                VerticalAlignment="Bottom"
                ArrowLeftClicked="sagLeftRight_ArrowLeftClicked"
                ArrowRightClicked="sagLeftRight_ArrowRightClicked" />

            <Image
                x:Name="image"
                Grid.Column="2"
                Margin="5"
                VerticalAlignment="Bottom"
                Source="/View/images/firin.png" />
            <Image
                x:Name="solkapi"
                Grid.Column="1"
                Height="270"
                Margin="5,45,5,0"
                VerticalAlignment="Top"
                Source="/View/images/solacikassa.png" />
            <Image
                x:Name="sagkapi"
                Grid.Column="3"
                Margin="5"
                VerticalAlignment="Bottom"
                Source="/View/images/sagacikassa.png" />


        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="700" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>



            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="210" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Border
                    Grid.Row="0"
                    Width="503"
                    Height="143"
                    Padding="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Background="Black"
                    BorderBrush="Gray"
                    BorderThickness="2"
                    CornerRadius="8">

                    <Canvas
                        x:Name="trendGraph"
                        Width="485"
                        Height="135"
                        Margin="10"
                        VerticalAlignment="Center" />
                </Border>


                <Grid
                    Grid.Row="0"
                    Width="700"
                    Height="60"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label
                        x:Name="MachineStatu"
                        Grid.Row="0"
                        Width="700"
                        Height="35"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Background="{x:Null}"
                        BorderBrush="{x:Null}"
                        Content="{x:Static resx:Resources.Machine_Statu}"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="#FFFDFDFD" />
                    <Label
                        x:Name="MachineStatu2"
                        Grid.Row="1"
                        Height="30"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Background="{x:Null}"
                        BorderBrush="{x:Null}"
                        Content=""
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="#FFFDFDFD" />
                </Grid>


                <StackPanel
                    Grid.Row="1"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <StackPanel Margin="10,0" Orientation="Horizontal">
                        <Rectangle
                            Width="30"
                            Height="4"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Fill="LightGreen" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{x:Static resx:Resources.receteDegeri}" />
                    </StackPanel>
                    <StackPanel Margin="10,0" Orientation="Horizontal">
                        <Rectangle
                            Width="30"
                            Height="4"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Fill="LightSkyBlue" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{x:Static resx:Resources.receteDegeri2}" />
                    </StackPanel>
                    <StackPanel Margin="20,0" Orientation="Horizontal">
                        <Rectangle
                            Width="30"
                            Height="4"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Fill="Yellow" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{x:Static resx:Resources.G1degeri}" />
                    </StackPanel>
                    <StackPanel Margin="20,0" Orientation="Horizontal">
                        <Rectangle
                            Width="30"
                            Height="4"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Fill="Orange" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{x:Static resx:Resources.G2Degeri}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="50" />
                    <RowDefinition Height="70" />
                </Grid.RowDefinitions>
                <Label
                    x:Name="ElapsedTime"
                    Grid.Row="0"
                    Height="35"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="{x:Null}"
                    BorderBrush="{x:Null}"
                    Content="{x:Static resx:Resources.gecenZaman}"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="#FFFDFDFD" />

                <Label
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Content="{x:Static resx:Resources.recete_sec}"
                    FontSize="18"
                    Foreground="White" />
                <Button
                    x:Name="btnReceteSec"
                    Grid.Row="2"
                    Width="150"
                    Height="50"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Click="btnReceteSec_Click"
                    Content="{x:Static resx:Resources.kaydet}"
                    Cursor="Hand"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="White">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Green" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <ComboBox
                    x:Name="comboBox"
                    Grid.Row="1"
                    Width="250"
                    Height="30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Red"
                    FontSize="15"
                    FontWeight="Bold">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} ({1})">
                                        <Binding Path="Adi" />
                                        <Binding Path="Adimlar">
                                            <Binding.Converter>
                                                <resx:ToplamSureConverter />
                                            </Binding.Converter>
                                        </Binding>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

        </Grid>

    </Grid>
</Page>
