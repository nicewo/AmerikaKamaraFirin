<Page
    x:Class="AmerikaKamaraFirin.View.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UControl="clr-namespace:AmerikaKamaraFirin.View.UControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AmerikaKamaraFirin.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:AmerikaKamaraFirin"
    Title="MainPage"
    d:DesignHeight="604"
    d:DesignWidth="1024"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="320" />
            <RowDefinition Height="20" />
            <RowDefinition />
        </Grid.RowDefinitions>


        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="400" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <UControl:UpDownTextbox
                x:Name="solUpDown"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="145,10,15,0"
                VerticalAlignment="Top"
                ArrowLeftClicked="solUpDown_ArrowLeftClicked"
                ArrowRightClicked="solUpDown_ArrowRightClicked">
                <UControl:UpDownTextbox.RenderTransform>
                    <ScaleTransform ScaleX="-1" />
                </UControl:UpDownTextbox.RenderTransform>
            </UControl:UpDownTextbox>
            <UControl:LeftRightTextbox
                x:Name="solLeftRight"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="145,0,15,0"
                VerticalAlignment="Bottom"
                ArrowLeftClicked="solLeftRight_ArrowLeftClicked"
                ArrowRightClicked="solLeftRight_ArrowRightClicked">
                <UControl:LeftRightTextbox.RenderTransform>
                    <ScaleTransform ScaleX="-1" />
                </UControl:LeftRightTextbox.RenderTransform>
            </UControl:LeftRightTextbox>




            <UControl:UpDownTextbox
                x:Name="sagUpDown"
                Grid.Column="4"
                Margin="12,10,10,0"
                VerticalAlignment="Top"
                ArrowLeftClicked="sagUpDown_ArrowLeftClicked"
                ArrowRightClicked="sagUpDown_ArrowRightClicked" />
            <UControl:LeftRightTextbox
                x:Name="sagLeftRight"
                Grid.Column="4"
                Margin="12,170,10,0"
                VerticalAlignment="Top"
                ArrowLeftClicked="sagLeftRight_ArrowLeftClicked"
                ArrowRightClicked="sagLeftRight_ArrowRightClicked" />


            <Image
                x:Name="image"
                Grid.Column="2"
                Height="275"
                Margin="0,30,0,0"
                VerticalAlignment="Top"
                Source="/View/firin.png"
                Stretch="Fill" />
            <Image
                x:Name="solkapi"
                Grid.Column="1"
                Width="150"
                Height="310"
                Margin="0,0,0,0"
                VerticalAlignment="Bottom"
                Source="/View/images/solacikassa.png" />
            <Image
                x:Name="sagkapi"
                Grid.Column="3"
                Width="150"
                Height="310"
                Margin="0,0,0,0"
                VerticalAlignment="Bottom"
                Source="/View/images/sagacikassa.png" />
            <TextBox
                x:Name="txb_damper1"
                Grid.Column="2"
                Margin="10,10,314,271"
                FontSize="24"
                FontWeight="Bold"
                PreviewMouseDown="PreviewMouseDown"
                Text="25"
                TextChanged="txb_damper1_TextChanged"
                TextWrapping="Wrap" />
            <TextBox
                x:Name="txb_damper2"
                Grid.Column="2"
                Margin="314,10,10,271"
                FontSize="24"
                FontWeight="Bold"
                PreviewMouseDown="PreviewMouseDown"
                Text="25"
                TextChanged="txb_damper2_TextChanged"
                TextWrapping="Wrap" />
            <Image
                x:Name="SolKlepe"
                Grid.Column="2"
                Width="100"
                Height="45"
                Margin="43,60,257,0"
                VerticalAlignment="Top"
                Source="/View/solKlepe.png"
                Stretch="Fill">
                <Image.RenderTransform>
                    <RotateTransform x:Name="SolKlepeRotate" Angle="-50" CenterX="10" CenterY="10" />
                </Image.RenderTransform>
            </Image>
            <Image
                x:Name="SolKlepeMerkez"
                Grid.Column="2"
                Width="80"
                Height="40"
                Margin="10,65,310,0"
                VerticalAlignment="Top"
                Source="/View/klepeMerkez.png"
                Stretch="Fill" />

            <Image
                x:Name="SagKlepe"
                Grid.Column="2"
                Width="100"
                Height="45"
                Margin="259,60,41,0"
                VerticalAlignment="Top"
                Source="/View/sagKlepe.png"
                Stretch="Fill">
                <Image.RenderTransform>
                    <RotateTransform x:Name="SagKlepeRotate" Angle="45" CenterX="90" CenterY="10" />
                </Image.RenderTransform>

            </Image>

            <Image
                x:Name="SagKlepeMerkez"
                Grid.Column="2"
                Width="80"
                Height="40"
                Margin="310,65,10,0"
                VerticalAlignment="Top"
                Source="/View/klepeMerkez.png"
                Stretch="Fill" />

        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="700" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>



            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="210" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Border
                    Grid.Row="0"
                    Width="503"
                    Height="143"
                    Padding="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Background="Black"
                    BorderBrush="Gray"
                    BorderThickness="2"
                    CornerRadius="8">

                    <Canvas
                        x:Name="trendGraph"
                        Width="485"
                        Height="135"
                        Margin="10"
                        VerticalAlignment="Center" />
                </Border>


                <Grid
                    Grid.Row="0"
                    Width="700"
                    Height="60"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label
                        x:Name="MachineStatu"
                        Grid.Row="0"
                        Width="700"
                        Height="35"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Background="{x:Null}"
                        BorderBrush="{x:Null}"
                        Content="{x:Static resx:Resources.Machine_Statu}"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="#FFFDFDFD" />
                    <Label
                        x:Name="MachineStatu2"
                        Grid.Row="1"
                        Height="30"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Background="{x:Null}"
                        BorderBrush="{x:Null}"
                        Content=""
                        FontSize="15"
                        FontWeight="Bold"
                        Foreground="#FFFDFDFD" />
                </Grid>


                <StackPanel
                    Grid.Row="1"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <StackPanel Margin="10,0" Orientation="Horizontal">
                        <Rectangle
                            Width="30"
                            Height="4"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Fill="LightGreen" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{x:Static resx:Resources.receteDegeri}" />
                    </StackPanel>
                    <StackPanel Margin="10,0" Orientation="Horizontal">
                        <Rectangle
                            Width="30"
                            Height="4"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Fill="LightSkyBlue" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{x:Static resx:Resources.receteDegeri2}" />
                    </StackPanel>
                    <StackPanel Margin="20,0" Orientation="Horizontal">
                        <Rectangle
                            Width="30"
                            Height="4"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Fill="Yellow" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{x:Static resx:Resources.G1degeri}" />
                    </StackPanel>
                    <StackPanel Margin="20,0" Orientation="Horizontal">
                        <Rectangle
                            Width="30"
                            Height="4"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Fill="Orange" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{x:Static resx:Resources.G2Degeri}" />
                    </StackPanel>
                </StackPanel>
                <Label
                    x:Name="lbl_tc1"
                    Margin="10,105,606,67"
                    Content="0 C"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="Yellow" />
                <Label
                    x:Name="lbl_tc2"
                    Margin="10,162,606,10"
                    Content="0 C"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="Orange" />
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="50" />
                    <RowDefinition Height="70" />
                </Grid.RowDefinitions>
                <Label
                    x:Name="ElapsedTime"
                    Grid.Row="0"
                    Height="35"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="{x:Null}"
                    BorderBrush="{x:Null}"
                    Content="{x:Static resx:Resources.gecenZaman}"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="#FFFDFDFD" />
                <Label
                    x:Name="ElapsedTimeStep"
                    Grid.Row="0"
                    Height="35"
                    Margin="0,31,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="{x:Null}"
                    BorderBrush="{x:Null}"
                    Content="{x:Static resx:Resources.recipegecenZaman}"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="#FFFDFDFD" />

                <Label
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Content="{x:Static resx:Resources.recete_sec}"
                    FontSize="18"
                    Foreground="White" />
                <Button
                    x:Name="btnReceteSec"
                    Grid.Row="2"
                    Width="150"
                    Height="50"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Click="btnReceteSec_Click"
                    Content="{x:Static resx:Resources.kaydet}"
                    Cursor="Hand"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="White">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Green" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <ComboBox
                    x:Name="comboBox"
                    Grid.Row="1"
                    Width="250"
                    Height="30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Red"
                    FontSize="15"
                    FontWeight="Bold">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} ({1})">
                                        <Binding Path="Adi" />
                                        <Binding Path="Adimlar">
                                            <Binding.Converter>
                                                <resx:ToplamSureConverter />
                                            </Binding.Converter>
                                        </Binding>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Label
                    x:Name="label"
                    Margin="198,63,50,56"
                    Content="Group 2"
                    Foreground="White" />
                <Label
                    x:Name="lblG2Akim"
                    Margin="211,88,37,23"
                    Content="0 A"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="White" />
                <Label
                    x:Name="label2"
                    Margin="53,63,195,56"
                    Content="Group 1"
                    Foreground="White" />
                <Label
                    x:Name="lblG1Akim"
                    Margin="66,88,182,28"
                    Content="0 A"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="White" />
            </Grid>

        </Grid>


    </Grid>
</Page>
