<UserControl
    x:Class="AmerikaKamaraFirin.View.UControl.LeftRightTextbox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AmerikaKamaraFirin.View.UControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:AmerikaKamaraFirin"
    Width="140"
    Height="140"
    d:Height="140"
    d:Width="140"
    mc:Ignorable="d">
    <Border
        Margin="0,0,0,0"
        Background="#7F000000"
        BorderBrush="{DynamicResource {x:Static SystemColors.MenuHighlightBrushKey}}"
        BorderThickness="1"
        CornerRadius="15">
        <Grid>
            <Grid.RowDefinitions>

                <RowDefinition />
                <RowDefinition />

            </Grid.RowDefinitions>
            <Border
                Grid.Row="0"
                Width="80"
                Height="60"
                Background="{Binding LeftButtonBackground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                BorderBrush="Green"
                BorderThickness="1"
                CornerRadius="20"
                Cursor="Hand"
                MouseLeftButtonDown="ArrowLeft_Click">
                <Path
                    x:Name="arrow"
                    Width="35"
                    Height="25"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Data="M228.657,290.4c0,1.844,1.068,3.524,2.75,4.3c1.664,0.775,3.638,0.514,5.042-0.685l78.044-66.035 l-78.044-66.034c-1.404-1.2-3.378-1.46-5.042-0.686c-1.681,0.775-2.75,2.456-2.75,4.3v33.392H37.79v58.064h190.868V290.4z"
                    Fill="White"
                    RenderTransformOrigin="0.5,0.5"
                    Stretch="Fill"
                    Stroke="White">
                    <Path.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform />
                            <SkewTransform />
                            <RotateTransform Angle="00.0" />
                            <TranslateTransform />
                        </TransformGroup>
                    </Path.RenderTransform>
                </Path>
            </Border>
            <Border
                Grid.Row="2"
                Width="80"
                Height="60"
                Background="{Binding RightButtonBackground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                BorderBrush="Green"
                BorderThickness="1"
                CornerRadius="20"
                Cursor="Hand"
                MouseLeftButtonDown="ArrowRight_Click">
                <Path
                    x:Name="arrow2"
                    Width="35"
                    Height="25"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Data="M228.657,290.4c0,1.844,1.068,3.524,2.75,4.3c1.664,0.775,3.638,0.514,5.042-0.685l78.044-66.035 l-78.044-66.034c-1.404-1.2-3.378-1.46-5.042-0.686c-1.681,0.775-2.75,2.456-2.75,4.3v33.392H37.79v58.064h190.868V290.4z"
                    Fill="White"
                    RenderTransformOrigin="0.5,0.5"
                    Stretch="Fill"
                    Stroke="White">
                    <Path.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform />
                            <SkewTransform />
                            <RotateTransform Angle="180.0" />
                            <TranslateTransform />
                        </TransformGroup>
                    </Path.RenderTransform>
                </Path>
            </Border>

        </Grid>
    </Border>
</UserControl>

